# Copia in .env e compila
DOMAIN=iot.example.com
PUBLIC_URL=https://iot.example.com
API_TOKEN=cambia-con-un-token-lungo-e-casuale

# Credenziali del backend verso Mosquitto (utente "backend" nel file passwd)
MQTT_USER=backend
MQTT_PASS=cambia-me

# Parametri incorporati nel firmware (utente "device" nel file passwd)
WIFI_SSID=la-tua-rete
WIFI_PASS=la-tua-password
DEVICE_MQTT_HOST=iot.example.com
DEVICE_MQTT_PORT=1883
DEVICE_MQTT_TLS=0
DEVICE_MQTT_USER=device
DEVICE_MQTT_PASS=cambia-me-device
